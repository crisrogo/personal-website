---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption: string;
	/** The widest the figure is drawn, in CSS pixels. */
	width?: number;
}

const { src, alt, caption, width = 1100 } = Astro.props;
---

<figure class="figure">
	<Image src={src} alt={alt} width={width} widths={[480, 800, width]} sizes={`(min-width: 72rem) ${width}px, 100vw`} quality={80} />
	<figcaption class="t-caption">{caption}</figcaption>
</figure>

<style>
	.figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 3);
	}

	.figure :global(img) {
		width: 100%;
		height: auto;
		background-color: var(--surface);
	}

	figcaption {
		color: var(--ink-faint);
		max-width: var(--measure);
	}
</style>
