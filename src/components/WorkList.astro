---
import WorkItem from './WorkItem.astro';
import type { Work } from '../lib/publications';

interface Props {
	works: Work[];
	showVenue?: boolean;
}

const { works, showVenue = true } = Astro.props;
---

<ol class="work-list">
	{works.map((work) => <WorkItem work={work} showVenue={showVenue} />)}
</ol>

<style>
	.work-list {
		display: flex;
		flex-direction: column;
		gap: calc(var(--spacing) * 5);
		list-style: none;
		padding: 0;
		margin: 0;
	}
</style>
